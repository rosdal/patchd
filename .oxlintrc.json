{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "import", "unicorn", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "no-underscore-dangle": ["warn", { "allow": ["__PATCHD_VERSION__"] }]
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/out/**",
    "**/routeTree.gen.ts",
    "engine/testdata/**",
    "engine/tsbridge/testdata/**",
    "engine/ir/testdata/**",
    ".patchd/**"
  ]
}
