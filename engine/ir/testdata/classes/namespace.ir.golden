module namespace.ts

func f1 <module>() module
b1.entry:
  v1 = this
  v2 = object {}
  store global Util = v2
  v3 = closure f2 []                      ; Util
  v4 = call v3(v2)
  return undefined

func f2 Util(Util) namespace in f1
