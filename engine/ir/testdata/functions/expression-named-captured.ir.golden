module expression-named-captured.ts

func f1 <module>() module
b1.entry:
  v1 = this
  v2 = closure f2 []                      ; loop
  store global f = v2
  return undefined

func f2 loop(n) function in f1
b1.entry:
  v1 = param n
  v2 = this
  v3 = self loop
  v4 = cell loop
  v5 = cell n
  store *v4 = v3
  store *v5 = v1
  v6 = closure f3 [v4, v5]                ; loop.<anon@2:10>
  return v6

func f3 loop.<anon@2:10>() arrow in f2
b1.entry:
  v1 = free loop (cell)
  v2 = free n (cell)
  v3 = load *v1
  v4 = load *v2
  v5 = const 1
  v6 = binop - v4 v5
  v7 = call v3(v6)
  return v7
