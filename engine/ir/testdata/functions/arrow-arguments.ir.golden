module arrow-arguments.ts

func f1 <module>() module
b1.entry:
  v1 = this
  v2 = closure f2 []                      ; f
  store global f = v2
  return undefined

func f2 f() function in f1
b1.entry:
  v1 = this
  v2 = arguments
  v3 = closure f3 [v2]                    ; f.g
  v4 = call v3()
  return v4

func f3 f.g() arrow in f2
b1.entry:
  v1 = free arguments
  v2 = load v1[0]
  return v2
