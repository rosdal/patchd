module destructured-param-default.ts

func f1 <module>() module
b1.entry:
  v1 = this
  v2 = closure f2 []                      ; f
  store global f = v2
  return undefined

func f2 f(v1) function in f1
b1.entry:
  v1 = param
  v2 = this
  v3 = binop === v1 undefined
  branch v3 b2.default b3.default.done
b2.default:  ; preds b1
  v4 = const 2
  v5 = object {b: v4}
  jump b3.default.done
b3.default.done:  ; preds b1 b2
  v6 = phi [b1: v1, b2: v5]
  v7 = load v6.a
  v8 = binop === v7 undefined
  branch v8 b4.default b5.default.done
b4.default:  ; preds b3
  v9 = const 1
  jump b5.default.done
b5.default.done:  ; preds b3 b4
  v10 = phi [b3: v7, b4: v9]
  v11 = load v6.b
  v12 = binop + v10 v11
  return v12
