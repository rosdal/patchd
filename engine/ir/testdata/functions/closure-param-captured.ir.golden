module closure-param-captured.ts

func f1 <module>() module
b1.entry:
  v1 = this
  v2 = closure f2 []                      ; f
  store global f = v2
  return undefined

func f2 f(req) function in f1
b1.entry:
  v1 = param req
  v2 = this
  v3 = cell req
  store *v3 = v1
  v4 = closure f3 [v3]                    ; f.<anon@2:10>
  return v4

func f3 f.<anon@2:10>() arrow in f2
b1.entry:
  v1 = free req (cell)
  v2 = load *v1
  v3 = load v2.body
  return v3
