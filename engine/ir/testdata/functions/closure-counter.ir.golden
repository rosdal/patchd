module closure-counter.ts

func f1 <module>() module
b1.entry:
  v1 = this
  v2 = closure f2 []                      ; counter
  store global counter = v2
  return undefined

func f2 counter() function in f1
b1.entry:
  v1 = this
  v2 = cell n
  v3 = const 0
  store *v2 = v3
  v4 = closure f3 [v2]                    ; counter.<anon@3:10>
  return v4

func f3 counter.<anon@3:10>() arrow in f2
b1.entry:
  v1 = free n (cell)
  v2 = load *v1
  v3 = const 1
  v4 = binop + v2 v3
  store *v1 = v4
  return v2
