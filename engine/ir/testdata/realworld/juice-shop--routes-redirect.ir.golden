func f5 performRedirect.<anon@15:10>.<anon@19:60>() arrow in f3
b1.entry:
  v1 = free toUrl (cell)
  v2 = load global isUnintendedRedirect
  v3 = load *v1
  v4 = call v2(v3)
  return v4

func f6 isUnintendedRedirect(toUrl) function in f1
b1.entry:
  v1 = param toUrl
  v2 = this
  v3 = const true
  v4 = load global security
  v5 = load v4.redirectAllowlist
  jump b2.forof.head
b2.forof.head:  ; preds b1 b5
  v6 = phi [b1: v3, b5: v10]
  branch * b3.forof.body b6.forof.done
b3.forof.body:  ; preds b2
  v7 = load v5[of]
  branch v6 b4.and.rhs b5.and.done
b4.and.rhs:  ; preds b3
  v8 = call v1.startsWith(v7) this=v1
  v9 = unop ! v8
  jump b5.and.done
b5.and.done:  ; preds b3 b4
  v10 = phi [b3: v6, b4: v9]
  jump b2.forof.head
b6.forof.done:  ; preds b2
  return v6
