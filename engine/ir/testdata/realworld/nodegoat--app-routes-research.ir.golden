func f3 ResearchHandler.displayResearch(req, res) arrow in f2
b1.entry:
  v1 = param req
  v2 = param res
  v3 = cell res
  store *v3 = v2
  v4 = load v1.query
  v5 = load v4.symbol
  branch v5 b2.if.then b3.if.done
b2.if.then:  ; preds b1
  v6 = load v1.query
  v7 = load v6.url
  v8 = load v1.query
  v9 = load v8.symbol
  v10 = binop + v7 v9
  v11 = load global needle
  v12 = closure f4 [v3]                   ; ResearchHandler.displayResearch.<anon@18:36>
  v13 = call v11.get(v10, v12) this=v11
  return v13
b3.if.done:  ; preds b1
  v14 = load *v3
  v15 = const "research"
  v16 = load global environmentalScripts
  v17 = object {environmentalScripts: v16}
  v18 = call v14.render(v15, v17) this=v14
