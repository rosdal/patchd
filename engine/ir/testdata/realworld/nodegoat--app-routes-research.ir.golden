func f2 ResearchHandler(db) function in f1
b1.entry:
  v1 = param db
  v2 = this
  v3 = const "use strict"
  v4 = load global ResearchDAO
  v5 = new v4(v1)
  v6 = closure f3 []                      ; ResearchHandler.displayResearch
  store v2.displayResearch = v6
