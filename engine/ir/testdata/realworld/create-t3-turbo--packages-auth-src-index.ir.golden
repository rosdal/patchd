  v12 = object {productionURL: v11}
  v13 = call v10(v12)
  v14 = load global expo
  v15 = call v14()
  v16 = load v1.extraPlugins
  v17 = binop == v16 undefined
  branch v17 b2.nullish.rhs b3.nullish.done
b2.nullish.rhs:  ; preds b1
  v18 = array []
  jump b3.nullish.done
b3.nullish.done:  ; preds b1 b2
  v19 = phi [b1: v16, b2: v18]
  v20 = spread v19
  v21 = array [v13, v15, ...v20]
  v22 = load v1.discordClientId
  v23 = load v1.discordClientSecret
  v24 = load v1.productionUrl
  v25 = template [v24, "/api/auth/callback/discord"]
  v26 = object {clientId: v22, clientSecret: v23, redirectURI: v25}
  v27 = object {discord: v26}
  v28 = const "expo://"
  v29 = array [v28]
  v30 = closure f3 []                     ; initAuth.config.onAPIError.onError
  v31 = object {onError(): v30}
  v32 = object {database: v7, baseURL: v8, secret: v9, plugins: v21, socialProviders: v27, trustedOrigins: v29, onAPIError: v31}
  v33 = load global betterAuth
  v34 = call v33(v32)
