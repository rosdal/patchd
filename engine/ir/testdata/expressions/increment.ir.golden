module increment.ts

func f1 <module>() module
b1.entry:
  v1 = this
  v2 = closure f2 []                      ; f
  store global f = v2
  return undefined

func f2 f(i) function in f1
b1.entry:
  v1 = param i
  v2 = this
  v3 = const 1
  v4 = binop + v1 v3
  v5 = v1
  v6 = const 1
  v7 = binop + v4 v6
  v8 = v7
  v9 = const 1
  v10 = binop - v7 v9
  v11 = v7
  v12 = const 1
  v13 = binop - v10 v12
  v14 = v13
  v15 = array [v5, v8, v11, v14]
  return v15
