module call-chain.ts

func f1 <module>() module
b1.entry:
  v1 = this
  v2 = closure f2 []                      ; f
  store global f = v2
  return undefined

func f2 f(s) function in f1
b1.entry:
  v1 = param s
  v2 = this
  v3 = call v1.trim() this=v1
  v4 = call v3.toLowerCase() this=v3
  v5 = const ","
  v6 = call v4.split(v5) this=v4
  return v6
