module logical-chain.ts

func f1 <module>() module
b1.entry:
  v1 = this
  v2 = closure f2 []                      ; f
  store global f = v2
  return undefined

func f2 f(a, b, c) function in f1
b1.entry:
  v1 = param a
  v2 = param b
  v3 = param c
  v4 = this
  branch v1 b2.and.rhs b3.and.done
b2.and.rhs:  ; preds b1
  jump b3.and.done
b3.and.done:  ; preds b1 b2
  v5 = phi [b1: v1, b2: v2]
  branch v5 b5.or.done b4.or.rhs
b4.or.rhs:  ; preds b3
  jump b5.or.done
b5.or.done:  ; preds b3 b4
  v6 = phi [b3: v5, b4: v3]
  return v6
