module optional-multiple.ts

func f1 <module>() module
b1.entry:
  v1 = this
  v2 = closure f2 []                      ; f
  store global f = v2
  return undefined

func f2 f(a) function in f1
b1.entry:
  v1 = param a
  v2 = this
  v3 = binop == v1 undefined
  branch v3 b5.opt.short b2.opt.cont
b2.opt.cont:  ; preds b1
  v4 = load v1.b
  v5 = binop == v4 undefined
  branch v5 b5.opt.short b3.opt.cont
b3.opt.cont:  ; preds b2
  v6 = load v4.c
  v7 = binop == v6 undefined
  branch v7 b5.opt.short b4.opt.cont
b4.opt.cont:  ; preds b3
  v8 = load v6.d
  jump b6.opt.done
b5.opt.short:  ; preds b1 b2 b3
  jump b6.opt.done
b6.opt.done:  ; preds b4 b5
  v9 = phi [b4: v8, b5: undefined]
  return v9
