module unary.ts

func f1 <module>() module
b1.entry:
  v1 = this
  v2 = closure f2 []                      ; f
  store global f = v2
  return undefined

func f2 f(a) function in f1
b1.entry:
  v1 = param a
  v2 = this
  v3 = unop ! v1
  v4 = unop - v1
  v5 = unop + v1
  v6 = unop ~ v1
  v7 = unop typeof v1
  v8 = unop void v1
  v9 = array [v3, v4, v5, v6, v7, v8]
  return v9
