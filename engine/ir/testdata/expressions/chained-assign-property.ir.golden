module chained-assign-property.ts

func f1 <module>() module
b1.entry:
  v1 = this
  v2 = closure f2 []                      ; f
  store global f = v2
  return undefined

func f2 f(a, b) function in f1
b1.entry:
  v1 = param a
  v2 = param b
  v3 = this
  v4 = const 1
  store v2.y = v4
  store v1.x = v4
  return undefined
