module string-concat.ts

func f1 <module>() module
b1.entry:
  v1 = this
  v2 = closure f2 []                      ; f
  store global f = v2
  return undefined

func f2 f(name) function in f1
b1.entry:
  v1 = param name
  v2 = this
  v3 = const "Hello, "
  v4 = binop + v3 v1
  v5 = const "!"
  v6 = binop + v4 v5
  return v6
