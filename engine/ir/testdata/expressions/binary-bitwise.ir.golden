module binary-bitwise.ts

func f1 <module>() module
b1.entry:
  v1 = this
  v2 = closure f2 []                      ; f
  store global f = v2
  return undefined

func f2 f(a, b) function in f1
b1.entry:
  v1 = param a
  v2 = param b
  v3 = this
  v4 = binop & v1 v2
  v5 = binop ^ v1 v2
  v6 = binop | v4 v5
  v7 = const 1
  v8 = binop << v1 v7
  v9 = binop | v6 v8
  v10 = const 2
  v11 = binop >> v1 v10
  v12 = binop | v9 v11
  v13 = const 3
  v14 = binop >>> v1 v13
  v15 = binop | v12 v14
  return v15
