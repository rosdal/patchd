module call-dynamic-method.ts

func f1 <module>() module
b1.entry:
  v1 = this
  v2 = closure f2 []                      ; f
  store global f = v2
  return undefined

func f2 f(o, m) function in f1
b1.entry:
  v1 = param o
  v2 = param m
  v3 = this
  v4 = const 1
  v5 = call v1[v2](v4) this=v1
  return v5
