module binary-arith.ts

func f1 <module>() module
b1.entry:
  v1 = this
  v2 = closure f2 []                      ; f
  store global f = v2
  return undefined

func f2 f(a, b) function in f1
b1.entry:
  v1 = param a
  v2 = param b
  v3 = this
  v4 = binop + v1 v2
  v5 = binop - v1 v2
  v6 = binop * v4 v5
  v7 = binop % v1 v2
  v8 = const 2
  v9 = binop ** v7 v8
  v10 = binop / v6 v9
  return v10
