module compound-assign.ts

func f1 <module>() module
b1.entry:
  v1 = this
  v2 = closure f2 []                      ; f
  store global f = v2
  return undefined

func f2 f(x) function in f1
b1.entry:
  v1 = param x
  v2 = this
  v3 = const 1
  v4 = binop + v1 v3
  v5 = const 2
  v6 = binop - v4 v5
  v7 = const 3
  v8 = binop * v6 v7
  v9 = const 4
  v10 = binop / v8 v9
  v11 = const 5
  v12 = binop % v10 v11
  v13 = const 2
  v14 = binop ** v12 v13
  v15 = const 1
  v16 = binop << v14 v15
  v17 = const 1
  v18 = binop >> v16 v17
  v19 = const 1
  v20 = binop >>> v18 v19
  v21 = const 7
  v22 = binop & v20 v21
  v23 = const 8
  v24 = binop | v22 v23
  v25 = const 9
  v26 = binop ^ v24 v25
  return v26
