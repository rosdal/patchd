module try-finally-return-override.ts

func f1 <module>() module
b1.entry:
  v1 = this
  v2 = closure f2 []                      ; f
  store global f = v2
  return undefined

func f2 f() function in f1
b1.entry:
  v1 = this
  jump b2.try
b2.try:  ; preds b1
  v2 = const 1
  v3 = const 2
  return v3
b3.finally.throw:  ; unreachable
  unreachable
b4.try.done:  ; unreachable
  return undefined
