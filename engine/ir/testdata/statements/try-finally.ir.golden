module try-finally.ts

func f1 <module>() module
b1.entry:
  v1 = this
  v2 = closure f2 []                      ; f
  store global f = v2
  return undefined

func f2 f(lock) function in f1
b1.entry:
  v1 = param lock
  v2 = this
  v3 = call v1.acquire() this=v1
  jump b2.try
b2.try:  ; preds b1
  v4 = load global work                   ; exceptional → b5.finally.throw
  jump b3.try
b3.try:  ; preds b2
  v5 = call v4()                          ; exceptional → b5.finally.throw
  jump b4.try
b4.try:  ; preds b3
  v6 = call v1.release() this=v1
  return v5
b5.finally.throw:  ; preds b2 b3
  v7 = catchval
  v8 = call v1.release() this=v1
  throw v7
b6.try.done:  ; unreachable
  return undefined
