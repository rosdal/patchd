module try-catch-rethrow.ts

func f1 <module>() module
b1.entry:
  v1 = this
  v2 = closure f2 []                      ; f
  store global f = v2
  return undefined

func f2 f() function in f1
b1.entry:
  v1 = this
  jump b2.try
b2.try:  ; preds b1
  v2 = load global run                    ; exceptional → b5.catch
  jump b3.try
b3.try:  ; preds b2
  v3 = call v2()                          ; exceptional → b5.catch
  jump b4.try
b4.try:  ; preds b3
  jump b8.try.done
b5.catch:  ; preds b2 b3
  v4 = catchval
  v5 = load global TypeError
  v6 = binop instanceof v4 v5
  branch v6 b6.if.then b7.if.done
b6.if.then:  ; preds b5
  return undefined
b7.if.done:  ; preds b5
  throw v4
b8.try.done:  ; preds b4
  return undefined
