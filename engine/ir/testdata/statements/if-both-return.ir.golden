module if-both-return.ts

func f1 <module>() module
b1.entry:
  v1 = this
  v2 = closure f2 []                      ; f
  store global f = v2
  return undefined

func f2 f(c) function in f1
b1.entry:
  v1 = param c
  v2 = this
  branch v1 b2.if.then b3.if.else
b2.if.then:  ; preds b1
  v3 = const 1
  return v3
b3.if.else:  ; preds b1
  v4 = const 2
  return v4
b4.if.done:  ; unreachable
  return undefined
