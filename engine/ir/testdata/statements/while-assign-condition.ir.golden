module while-assign-condition.ts

func f1 <module>() module
b1.entry:
  v1 = this
  v2 = closure f2 []                      ; f
  store global f = v2
  return undefined

func f2 f(re, s) function in f1
b1.entry:
  v1 = param re
  v2 = param s
  v3 = this
  v4 = array []
  jump b2.while.head
b2.while.head:  ; preds b1 b3
  v5 = call v1.exec(v2) this=v1
  v6 = const null
  v7 = binop !== v5 v6
  branch v7 b3.while.body b4.while.done
b3.while.body:  ; preds b2
  v8 = load v5[0]
  v9 = call v4.push(v8) this=v4
  jump b2.while.head
b4.while.done:  ; preds b2
  return v4
