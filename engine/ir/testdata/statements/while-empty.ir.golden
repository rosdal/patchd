module while-empty.ts

func f1 <module>() module
b1.entry:
  v1 = this
  v2 = closure f2 []                      ; f
  store global f = v2
  return undefined

func f2 f(it) function in f1
b1.entry:
  v1 = param it
  v2 = this
  jump b2.while.head
b2.while.head:  ; preds b1 b3
  v3 = call v1.next() this=v1
  branch v3 b3.while.body b4.while.done
b3.while.body:  ; preds b2
  jump b2.while.head
b4.while.done:  ; preds b2
  return undefined
