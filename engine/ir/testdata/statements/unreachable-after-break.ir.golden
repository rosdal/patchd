module unreachable-after-break.ts

func f1 <module>() module
b1.entry:
  v1 = this
  v2 = closure f2 []                      ; f
  store global f = v2
  return undefined

func f2 f(xs) function in f1
b1.entry:
  v1 = param xs
  v2 = this
  jump b2.forof.head
b2.forof.head:  ; preds b1 b4
  branch * b3.forof.body b5.forof.done
b3.forof.body:  ; preds b2
  v3 = load v1[of]
  jump b5.forof.done
b4.unreachable:  ; unreachable
  v4 = load global use
  v5 = call v4(undefined)
  jump b2.forof.head
b5.forof.done:  ; preds b2 b3
  return undefined
