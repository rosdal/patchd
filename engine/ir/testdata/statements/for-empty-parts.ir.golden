module for-empty-parts.ts

func f1 <module>() module
b1.entry:
  v1 = this
  v2 = closure f2 []                      ; f
  store global f = v2
  return undefined

func f2 f() function in f1
b1.entry:
  v1 = this
  v2 = const 0
  jump b2.for.head
b2.for.head:  ; preds b1 b6
  v3 = phi [b1: v2, b6: v5]
  jump b3.for.body
b3.for.body:  ; preds b2
  v4 = const 1
  v5 = binop + v3 v4
  v6 = const 3
  v7 = binop > v3 v6
  branch v7 b4.if.then b5.if.done
b4.if.then:  ; preds b3
  jump b7.for.done
b5.if.done:  ; preds b3
  jump b6.for.update
b6.for.update:  ; preds b5
  jump b2.for.head
b7.for.done:  ; preds b4
  return v5
