module if-then.ts

func f1 <module>() module
b1.entry:
  v1 = this
  v2 = closure f2 []                      ; f
  store global f = v2
  return undefined

func f2 f(c) function in f1
b1.entry:
  v1 = param c
  v2 = this
  v3 = const 0
  branch v1 b2.if.then b3.if.done
b2.if.then:  ; preds b1
  v4 = const 1
  jump b3.if.done
b3.if.done:  ; preds b1 b2
  v5 = phi [b1: v3, b2: v4]
  return v5
