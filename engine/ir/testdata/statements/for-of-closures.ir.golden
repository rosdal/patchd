module for-of-closures.ts

func f1 <module>() module
b1.entry:
  v1 = this
  v2 = closure f2 []                      ; f
  store global f = v2
  return undefined

func f2 f(xs) function in f1
b1.entry:
  v1 = param xs
  v2 = this
  v3 = cell xs
  store *v3 = v1
  v4 = load *v3
  v5 = closure f3 [v3]                    ; f.<anon@2:17>
  v6 = call v4.map(v5) this=v4
  return v6

func f3 f.<anon@2:17>(x) arrow in f2
b1.entry:
  v1 = param x
  v2 = free xs (cell)
  v3 = cell x
  store *v3 = v1
  v4 = array []
  v5 = load *v2
  jump b2.forof.head
b2.forof.head:  ; preds b1 b3
  branch * b3.forof.body b4.forof.done
b3.forof.body:  ; preds b2
  v6 = cell y
  v7 = load v5[of]
  store *v6 = v7
  v8 = closure f4 [v3, v6]                ; f.<anon@2:17>.<anon@4:34>
  v9 = call v4.push(v8) this=v4
  jump b2.forof.head
b4.forof.done:  ; preds b2
  return v4

func f4 f.<anon@2:17>.<anon@4:34>() arrow in f3
b1.entry:
  v1 = free x (cell)
  v2 = free y (cell)
  v3 = load *v1
  v4 = load *v2
  v5 = binop + v3 v4
  return v5
