module for-of.ts

func f1 <module>() module
b1.entry:
  v1 = this
  v2 = closure f2 []                      ; f
  store global f = v2
  return undefined

func f2 f(xs) function in f1
b1.entry:
  v1 = param xs
  v2 = this
  jump b2.forof.head
b2.forof.head:  ; preds b1 b3
  branch * b3.forof.body b4.forof.done
b3.forof.body:  ; preds b2
  v3 = load v1[of]
  v4 = load global console
  v5 = call v4.log(v3) this=v4
  jump b2.forof.head
b4.forof.done:  ; preds b2
  return undefined
