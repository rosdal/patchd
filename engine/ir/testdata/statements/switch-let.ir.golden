module switch-let.ts

func f1 <module>() module
b1.entry:
  v1 = this
  v2 = closure f2 []                      ; f
  store global f = v2
  return undefined

func f2 f(n) function in f1
b1.entry:
  v1 = param n
  v2 = this
  v3 = const 1
  v4 = binop === v1 v3
  branch v4 b4.switch.case b2.switch.test
b2.switch.test:  ; preds b1
  v5 = const 2
  v6 = binop === v1 v5
  branch v6 b5.switch.case b3.switch.test
b3.switch.test:  ; preds b2
  jump b6.switch.done
b4.switch.case:  ; preds b1
  v7 = const 2
  v8 = binop * v1 v7
  return v8
b5.switch.case:  ; preds b2
  v9 = const 3
  return v9
b6.switch.done:  ; preds b3
  return undefined
