module if-else.ts

func f1 <module>() module
b1.entry:
  v1 = this
  v2 = closure f2 []                      ; f
  store global f = v2
  return undefined

func f2 f(c) function in f1
b1.entry:
  v1 = param c
  v2 = this
  branch v1 b2.if.then b3.if.else
b2.if.then:  ; preds b1
  v3 = const "yes"
  jump b4.if.done
b3.if.else:  ; preds b1
  v4 = const "no"
  jump b4.if.done
b4.if.done:  ; preds b2 b3
  v5 = phi [b2: v3, b3: v4]
  return v5
