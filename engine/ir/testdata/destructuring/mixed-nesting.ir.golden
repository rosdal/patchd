module mixed-nesting.ts

func f1 <module>() module
b1.entry:
  v1 = this
  v2 = closure f2 []                      ; f
  store global f = v2
  return undefined

func f2 f(res) function in f1
b1.entry:
  v1 = param res
  v2 = this
  v3 = load v1.data                       ; path v1.data
  v4 = spread v3
  v5 = load v4[0]                         ; first, path v1.data[0]
  v6 = load v4[1]                         ; path v1.data[1]
  v7 = load v6.id                         ; id, path v1.data[1].id
  v8 = array [v5, v7]
  return v8
