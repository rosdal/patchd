module assignment-nested.ts

func f1 <module>() module
b1.entry:
  v1 = this
  v2 = closure f2 []                      ; f
  store global f = v2
  return undefined

func f2 f(o) function in f1
b1.entry:
  v1 = param o
  v2 = this
  v3 = load v1.x                          ; path v1.x
  v4 = spread v3
  v5 = load v4[0]                         ; a, path v1.x[0]
  v6 = load v4[1]                         ; path v1.x[1]
  v7 = load v6.b                          ; b, path v1.x[1].b
  v8 = array [v5, v7]
  return v8
