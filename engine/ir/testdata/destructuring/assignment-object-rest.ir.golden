module assignment-object-rest.ts

func f1 <module>() module
b1.entry:
  v1 = this
  v2 = closure f2 []                      ; f
  store global f = v2
  return undefined

func f2 f(src) function in f1
b1.entry:
  v1 = param src
  v2 = this
  v3 = load v1.id                         ; id, path v1.id
  v4 = object {...v1, -id}                ; others, path v1.<rest>
  return v4
