module param-array-default.ts

func f1 <module>() module
b1.entry:
  v1 = this
  v2 = closure f2 []                      ; f
  store global f = v2
  return undefined

func f2 f(v1) function in f1
b1.entry:
  v1 = param
  v2 = this
  v3 = binop === v1 undefined
  branch v3 b2.default b3.default.done
b2.default:  ; preds b1
  v4 = const 1
  v5 = const 2
  v6 = array [v4, v5]
  jump b3.default.done
b3.default.done:  ; preds b1 b2
  v7 = phi [b1: v1, b2: v6]
  v8 = spread v7
  v9 = load v8[0]                         ; a, path v1[0]
  v10 = load v8[1]                        ; b, path v1[1]
  v11 = binop + v9 v10
  return v11
