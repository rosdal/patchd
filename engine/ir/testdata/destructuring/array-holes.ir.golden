module array-holes.ts

func f1 <module>() module
b1.entry:
  v1 = this
  v2 = closure f2 []                      ; f
  store global f = v2
  return undefined

func f2 f(xs) function in f1
b1.entry:
  v1 = param xs
  v2 = this
  v3 = spread v1
  v4 = load v3[0]                         ; path v1[0]
  v5 = load v3[1]                         ; second, path v1[1]
  v6 = load v3[2]                         ; path v1[2]
  v7 = load v3[3]                         ; fourth, path v1[3]
  v8 = array [v5, v7]
  return v8
