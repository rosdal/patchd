module param-nested-default.ts

func f1 <module>() module
b1.entry:
  v1 = this
  v2 = closure f2 []                      ; f
  store global f = v2
  return undefined

func f2 f(v1) function in f1
b1.entry:
  v1 = param
  v2 = this
  v3 = load v1.a                          ; path v1.a
  v4 = binop === v3 undefined
  branch v4 b2.default b3.default.done
b2.default:  ; preds b1
  v5 = const 1
  v6 = object {b: v5}
  jump b3.default.done
b3.default.done:  ; preds b1 b2
  v7 = phi [b1: v3, b2: v6]
  v8 = load v7.b                          ; b, path v1.a.b
