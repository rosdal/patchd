module object-rename.ts

func f1 <module>() module
b1.entry:
  v1 = this
  v2 = closure f2 []                      ; f
  store global f = v2
  return undefined

func f2 f(o) function in f1
b1.entry:
  v1 = param o
  v2 = this
  v3 = load v1.a                          ; x, path v1.a
  v4 = load v1.b                          ; y, path v1.b
  v5 = binop + v3 v4
  return v5
