module object-rest.ts

func f1 <module>() module
b1.entry:
  v1 = this
  v2 = closure f2 []                      ; f
  store global f = v2
  return undefined

func f2 f(o) function in f1
b1.entry:
  v1 = param o
  v2 = this
  v3 = load v1.id                         ; id, path v1.id
  v4 = load v1.secret                     ; secret, path v1.secret
  v5 = object {...v1, -id, -secret}       ; rest, path v1.<rest>
  return v5
