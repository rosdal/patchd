module generator-await-yield.ts

func f1 <module>() module
b1.entry:
  v1 = this
  v2 = closure f2 []                      ; gen
  store global gen = v2
  return undefined

func f2 gen(urls) function async generator in f1
b1.entry:
  v1 = param urls
  v2 = this
  jump b2.forof.head
b2.forof.head:  ; preds b1 b3
  branch * b3.forof.body b4.forof.done
b3.forof.body:  ; preds b2
  v3 = load v1[of]
  v4 = load global fetch
  v5 = call v4(v3)
  v6 = await v5
  v7 = yield v6
  jump b2.forof.head
b4.forof.done:  ; preds b2
  return undefined
