{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plan",
  "description": "What `apply` will install, across providers.",
  "type": "object",
  "properties": {
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "filter": {
      "$ref": "#/$defs/Filter"
    },
    "id": {
      "description": "A `UUIDv7`, so plan IDs sort by creation time.",
      "type": "string",
      "format": "uuid"
    },
    "providers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProviderPlan"
      }
    }
  },
  "required": [
    "id",
    "created_at",
    "filter",
    "providers"
  ],
  "$defs": {
    "Filter": {
      "description": "Which updates a plan selects.",
      "oneOf": [
        {
          "description": "Security updates, plus the new packages they pull in.",
          "type": "string",
          "const": "security"
        },
        {
          "description": "Every pending update.",
          "type": "string",
          "const": "all"
        }
      ]
    },
    "ProviderId": {
      "description": "Identifies a provider, serialized as a plain string such as `\"apt\"`.",
      "type": "string"
    },
    "ProviderPlan": {
      "description": "One provider's part of a plan.",
      "type": "object",
      "properties": {
        "held_skipped": {
          "description": "Updates the filter selected but the plan leaves out: held or excluded.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/SkippedUpdate"
          }
        },
        "id": {
          "$ref": "#/$defs/ProviderId"
        },
        "removals": {
          "description": "Packages installing the plan would remove. `apply` refuses unless\n`allow_removals` is set.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "updates": {
          "description": "Each pinned to its `to_version`.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Update"
          }
        },
        "warnings": {
          "description": "Anything that will make `apply` abort or behave unexpectedly.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "updates",
        "held_skipped",
        "removals",
        "warnings"
      ]
    },
    "SkipReason": {
      "oneOf": [
        {
          "description": "Pinned with `apt-mark hold` or `dnf versionlock`.",
          "type": "string",
          "const": "held"
        },
        {
          "description": "Matched an `apply.exclude` glob.",
          "type": "string",
          "const": "excluded"
        }
      ]
    },
    "SkippedUpdate": {
      "description": "An update the provider can install.",
      "type": "object",
      "properties": {
        "arch": {
          "type": [
            "string",
            "null"
          ]
        },
        "from_version": {
          "description": "`None` when the update pulls in a new package, typically a new kernel.",
          "type": [
            "string",
            "null"
          ]
        },
        "held": {
          "description": "Available, but pinned by `apt-mark hold`, so an upgrade will skip it.",
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/UpdateKind"
        },
        "name": {
          "type": "string"
        },
        "origins": {
          "description": "Where the new version comes from, such as `Ubuntu:24.04/noble-security`.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "provider": {
          "$ref": "#/$defs/ProviderId"
        },
        "reason": {
          "$ref": "#/$defs/SkipReason"
        },
        "to_version": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "name",
        "to_version",
        "kind",
        "origins",
        "held",
        "reason"
      ]
    },
    "Update": {
      "description": "An update the provider can install.",
      "type": "object",
      "properties": {
        "arch": {
          "type": [
            "string",
            "null"
          ]
        },
        "from_version": {
          "description": "`None` when the update pulls in a new package, typically a new kernel.",
          "type": [
            "string",
            "null"
          ]
        },
        "held": {
          "description": "Available, but pinned by `apt-mark hold`, so an upgrade will skip it.",
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/UpdateKind"
        },
        "name": {
          "type": "string"
        },
        "origins": {
          "description": "Where the new version comes from, such as `Ubuntu:24.04/noble-security`.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "provider": {
          "$ref": "#/$defs/ProviderId"
        },
        "to_version": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "name",
        "to_version",
        "kind",
        "origins",
        "held"
      ]
    },
    "UpdateKind": {
      "type": "string",
      "enum": [
        "security",
        "minor",
        "major"
      ]
    }
  }
}
